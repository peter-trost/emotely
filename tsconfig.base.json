{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // exactOptionalPropertyTypes stays OFF: ai@7's ToolSet types are not
    // exactOptional-clean (tool() results fail the index-signature check).
    // Re-try on the next major bump of `ai`.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "noEmit": false,
    "declaration": true,
    "composite": true,
    "skipLibCheck": true
  }
}
