{
  "ask_question": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "question_id": {
        "type": "string",
        "minLength": 1
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "answer_type": {
        "type": "string",
        "enum": [
          "color",
          "emoji",
          "longtext",
          "rating",
          "text_list"
        ]
      }
    },
    "required": [
      "question_id",
      "question",
      "answer_type"
    ]
  },
  "record_answer": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "question_id": {
        "type": "string",
        "minLength": 1
      },
      "answer": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "answer_type": {
                "type": "string",
                "const": "color"
              },
              "value": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              }
            },
            "required": [
              "answer_type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "answer_type": {
                "type": "string",
                "const": "emoji"
              },
              "value": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "answer_type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "answer_type": {
                "type": "string",
                "const": "longtext"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "answer_type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "answer_type": {
                "type": "string",
                "const": "rating"
              },
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "answer_type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "answer_type": {
                "type": "string",
                "const": "text_list"
              },
              "value": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "answer_type",
              "value"
            ]
          }
        ]
      }
    },
    "required": [
      "question_id",
      "answer"
    ]
  },
  "complete_session": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "summary": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "summary"
    ]
  }
}
