# frozen_string_literal: true

# Release lanes for the Flutter app (ADR 0013). Everything an agent needs to
# ship a build runs from here; the human steps are the store dashboards.
#
#   bundle exec fastlane ios certificates   one-time / rotation: mint the
#                                           App Store certificate + profile
#                                           into the match repo (needs the
#                                           ASC API key + MATCH_PASSWORD)
#   bundle exec fastlane ios beta           build the IPA, upload to TestFlight
#                                           and distribute it to the external
#                                           `Beta` group (the internal `Team`
#                                           group sees every build by itself)
#   bundle exec fastlane android beta       build the AAB, upload it to Play
#                                           `internal` and promote it to the
#                                           closed `alpha` track
#
# Inputs, all environment variables (secrets of the `release` environment):
#   APP_STORE_CONNECT_API_KEY_ID / _ISSUER_ID / _API_KEY_P8   the ASC API key
#   MATCH_PASSWORD                                            match encryption
#   PLAY_SERVICE_ACCOUNT_JSON                                 Play upload account
#   POSTHOG_KEY                                               analytics token
#   BUILD_NUMBER                                              monotonic build id

# The rebuild starts at 2.0.0 (ADR 0012): the legacy app got to 1.21.15.
BUILD_NAME = "2.0.0"

def build_number
  ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER is not set") }
end

def dart_defines
  defines = []
  defines << "--dart-define=POSTHOG_KEY=#{ENV.fetch("POSTHOG_KEY")}" if ENV["POSTHOG_KEY"].to_s != ""
  defines
end

# apps/mobile/app. Lanes run from here, but `sh` runs inside fastlane/, so the
# flutter command gets an explicit `cd`.
APP_DIR = File.expand_path("..", FastlaneCore::FastlaneFolder.path)

def flutter(*args)
  require "shellwords"
  sh("cd #{Shellwords.escape(APP_DIR)} && flutter #{Shellwords.join(args)}")
end

platform :ios do
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      in_house: false
    )
  end

  desc "Mint (or rotate) the App Store signing certificate and profile into the match repo"
  lane :certificates do
    match(type: "appstore", readonly: false, api_key: asc_api_key)
  end

  desc "Build the release IPA, signed with what match holds (no upload)"
  lane :build do
    api_key = asc_api_key
    # On CI, a throwaway keychain that match can import into.
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: api_key)

    # Xcode signs manually with what match installed; CODE_SIGN_STYLE in the
    # project stays Automatic for local development.
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: "VCZSHMZY25",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "de.emotely.emotely",
      profile_name: ENV.fetch("sigh_de.emotely.emotely_appstore_profile-name"),
      targets: ["Runner"]
    )

    flutter(
      "build", "ipa", "--release",
      "--build-name=#{BUILD_NAME}", "--build-number=#{build_number}",
      "--export-options-plist=fastlane/ExportOptions.plist",
      *dart_defines
    )

    ipa = Dir.glob(File.join(APP_DIR, "build/ios/ipa/*.ipa")).first
    UI.user_error!("no IPA under build/ios/ipa") if ipa.nil?
    lane_context[:IPA_OUTPUT_PATH] = ipa
  end

  # Shown to testers as "What to Test". Static: every build is the same ask.
  BETA_CHANGELOG = <<~TEXT.strip
    emotely is an evening journaling assistant. Please write an entry on a
    few evenings — ideally on different days, so you see how it picks up
    where you left off. Anything that felt off, confusing or slow is worth
    reporting: tap "Send feedback" on the account screen.
  TEXT

  desc "Build the release IPA, upload it to TestFlight and distribute it to the Beta group"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: lane_context[:IPA_OUTPUT_PATH],
      app_identifier: "de.emotely.emotely",
      # External distribution means pilot has to wait for Apple to finish
      # processing: with skip_waiting_for_build_processing it returns before
      # distribute_build and nothing reaches a group (pilot/build_manager.rb,
      # `return if !build.ready_for_internal_testing? && skip_waiting...`).
      # That makes this job take Apple's 10-30 min; accepted, it is the only
      # way to hand a build to external testers unattended.
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      # Only the external group, by exact name. The internal `Team` group
      # has "access to all builds" turned on in App Store Connect, so every
      # build reaches it on its own, and naming it here is rejected by Apple
      # ("Builds cannot be assigned to this internal group", run 35510026821).
      # `distribute_external` without `groups` is a hard error in pilot, and
      # a changelog is required with it.
      groups: ["Beta"],
      changelog: BETA_CHANGELOG,
      notify_external_testers: true,
      # submit_beta_review defaults to true and pilot only posts a submission
      # when the build is `ready_for_beta_submission?`, so the first build of
      # a version goes to Beta App Review and later ones are a no-op.
      #
      # Deliberately not set: `beta_app_review_info` (contact + demo account
      # already live in App Store Connect, and passing it would overwrite
      # them on every run), `uses_non_exempt_encryption` (Info.plist already
      # carries ITSAppUsesNonExemptEncryption=false) and
      # `expire_previous_builds` (testers keep the older build until they
      # update).
    )
  end
end

platform :android do
  desc "Build the release App Bundle, upload it to Play internal and promote it to the closed alpha track"
  lane :beta do
    flutter(
      "build", "appbundle", "--release",
      "--build-name=#{BUILD_NAME}", "--build-number=#{build_number}",
      *dart_defines
    )

    play_store_defaults = {
      package_name: "de.emotely.emotely",
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    }

    # 1. The AAB, to `internal` — instant dogfood, no Google review.
    upload_to_play_store(
      **play_store_defaults,
      track: "internal",
      aab: File.join(APP_DIR, "build/app/outputs/bundle/release/app-release.aab")
    )

    # 2. The same version code, promoted to the closed track `alpha` ("Closed
    # testing - Alpha" in the console, testers = the "emotely beta" list).
    #
    # This has to be a second call. supply ignores `track_promote_to` whenever
    # it uploaded a binary in the same edit: perform_upload only reaches
    # promote_track in the `else` of `if uploading_new_binaries`
    # (supply/lib/supply/uploader.rb), so `track: "internal"` +
    # `track_promote_to: "alpha"` in one call would upload to internal and
    # silently never touch alpha. skip_upload_aab keeps this edit binary-free
    # so the promote branch runs; version_code pins it to the build we just
    # uploaded rather than whatever else sits on internal.
    #
    # Google reviews closed-testing releases, so this one does not go live
    # for testers immediately.
    upload_to_play_store(
      **play_store_defaults,
      skip_upload_aab: true,
      track: "internal",
      track_promote_to: "alpha",
      version_code: Integer(build_number)
    )
  end
end
